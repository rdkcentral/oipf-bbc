{
    "name": "oipf-bbc",
    "version": "1.0.0",
    "description": "Libraries needed for OIPF interface on RDK",
    "scripts": {
        "build": "run-s clean build:lib:prod",
        "watch": "webpack --mode=development --watch --config-name oipf-bbc",
        "clean": "trash dist/*",
        "build:lib:prod": "webpack --mode=production --config-name oipf-bbc",
        "build:lib:dev": "webpack --mode=development --config-name oipf-bbc",
        "zip": "node scripts/zip-dist.js",
        "test": "NODE_PATH=./lib mocha",
        "serve:testapp": "webpack serve --mode=development --config-name testapp",
        "validate:testapp": "node scripts/validate-testapp.js",
        "build:testapp": "webpack --mode=production --config-name testapp",
        "build:testapp:dev": "webpack --mode=production --config-name testapp --env withLib",
		"serve:remotecontrol": "node stb-remote-control/server.js"
    },
    "author": "Infosys",
    "license": "Apache-2.0",
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/eslint-parser": "7.19.1",
        "@babel/preset-env": "^7.28.3",
        "@babel/register": "^7.29.7",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "bestzip": "^2.2.5",
        "chai": "4.1.2",
        "clean-webpack-plugin": "0.1.19",
        "copy-webpack-plugin": "^14.0.0",
        "create-file-webpack": "1.0.2",
        "css-loader": "^7.1.4",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "dotenv": "4.0.0",
        "eslint": "8.29.0",
        "eslint-webpack-plugin": "3.2.0",
        "git-revision-webpack-plugin": "3.0.3",
        "html-loader": "^5.1.0",
        "html-webpack-plugin": "^5.6.7",
        "mini-css-extract-plugin": "2.7.2",
        "mocha": "^11.7.6",
        "mock-socket": "8.0.2",
        "node-ssh": "^13.2.1",
        "npm-run-all": "4.1.5",
        "prettier": "1.14.3",
        "prettier-loader": "2.1.1",
        "proxyquire": "^2.1.3",
        "sass": "1.77.8",
        "sass-loader": "13.2.0",
        "speed-measure-webpack-plugin": "1.5.0",
        "tar": "^7.5.16",
        "terser-webpack-plugin": "^5.6.0",
        "trash-cli": "^7.2.0",
        "ts-loader": "^9.6.2",
        "typescript": "^5.9.3",
        "webpack": "^5.107.2",
        "webpack-bundle-analyzer": "^5.3.0",
        "webpack-cli": "5.0.1",
        "webpack-dev-server": "^5.2.6",
        "zod": "^4.4.3"
    },
    "overrides": {
        "serialize-javascript": "^7.0.5"
    }
}
