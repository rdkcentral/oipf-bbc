        "target": "es2020",
        "module": "esnext",
        "moduleResolution": "node",
        "lib": ["dom", "es2020"],
        "baseUrl": ".",
        "strict": true,
        "isolatedModules": true,
        "skipLibCheck": true
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "dist",
        "bolt"
    ]
}
