{
  "id": "com.rdkcentral.oipfBbcTestApp",
  "specVersion": "1.1.0",
  "version": "0.2.0",
  "versionName": "develop",
  "name": "OIPF BBC Integration Test App",
  "packageType": "application",
  "entryPoint": "--verbose --dev file:///usr/share/com.rdkcentral.oipfBbcTestApp/index.html",
  "dependencies": {
    "com.rdkcentral.wpe": "~0.4.2"
  },
  "permissions": [
    "urn:rdk:permission:internet",
    "urn:rdk:permission:firebolt"
  ],
  "configuration": {
    "urn:rdk:config:overrides": {
      "application": {
        "options": [
          {
            "key": "userscripts",
            "value": "/usr/share/com.rdkcentral.oipfBbcTestApp/oipf-bbc.js"
          },
          {
            "key": "userstylesheets",
            "value": "/usr/share/com.rdkcentral.oipfBbcTestApp/oipf-bbc.css"
          }
        ]
      }
    }
  }
}