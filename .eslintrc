{
    "parser": "@babel/eslint-parser",
    "parserOptions": {
        "requireConfigFile": false,
        "sourceType": "module"
    },
    "rules": {
        "wrap-iife": ["error", "any"],
        "dot-notation": "error",
        "new-cap": ["error", { "capIsNew": false }],
        "no-caller": "error"
    },
    "overrides": [
        {
            "files": ["*.ts"],
            "parser": "@typescript-eslint/parser",
            "plugins": ["@typescript-eslint"],
            "rules": {
                "no-undef": "off"
            }
        }
    ]
}
